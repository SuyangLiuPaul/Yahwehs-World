<!-- Merged by Tauri into the iOS/iPadOS Info.plist (cargo tauri ios init). Localised names: tools/shell/ios_patch.py adds
     locales/*.lproj/InfoPlist.strings to the Xcode project. ITSAppUsesNonExemptEncryption=false is the owner's export-compliance
     answer for an app whose only cryptography is HTTPS through the OS (docs/gallery-shells.md, "App Store Connect"). -->
<plist version="1.0">
<dict>
  <key>CFBundleDisplayName</key><string>Yahweh's World</string>
  <key>CFBundleLocalizations</key>
  <array><string>en</string><string>zh-Hans</string><string>zh-Hant</string><string>ru</string></array>
  <key>ITSAppUsesNonExemptEncryption</key><false/>
  <key>LSApplicationCategoryType</key><string>public.app-category.education</string>
  <key>UIViewControllerBasedStatusBarAppearance</key><true/>
</dict>
</plist>
