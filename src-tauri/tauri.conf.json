{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Yahweh's World",
  "mainBinaryName": "YahwehsWorld",
  "version": "1.0.0",
  "identifier": "com.yahwehword.world",
  "build": {
    "frontendDist": "../dist-shell",
    "devUrl": "http://localhost:5175",
    "beforeDevCommand": "VITE_SURFACE=gallery VITE_TARGET=shell npm run dev -- --port 5175 --strictPort",
    "beforeBuildCommand": "npm run app:dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "雅偉之界 · Yahweh's World",
        "width": 1280,
        "height": 800,
        "minWidth": 480,
        "minHeight": 360,
        "resizable": true,
        "fullscreen": false,
        "backgroundColor": "#060d16"
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline' https://fonts.googleapis.com",
        "img-src": "'self' data: blob: https://world.yahwehword.com asset: http://asset.localhost",
        "font-src": "'self' data: https://fonts.gstatic.com",
        "connect-src": "'self' ipc: http://ipc.localhost https://world.yahwehword.com https://api.github.com",
        "worker-src": "'self' blob:",
        "object-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'self'"
      },
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPLOCALDATA/pictures/**"
        ]
      }
    }
  },
  "plugins": {
    "deep-link": {
      "mobile": [
        {
          "scheme": [
            "https"
          ],
          "host": "world.yahwehword.com",
          "pathPrefix": [
            "/p/"
          ],
          "appLink": true
        }
      ],
      "desktop": {
        "schemes": [
          "yahwehsworld"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Yahweh's People",
    "copyright": "Yahweh's People",
    "category": "Education",
    "shortDescription": "1,443 scenes of the Bible, each opening onto its verses",
    "longDescription": "雅偉之界 / Yahweh's World: 1,443 drawn scenes of the Bible, each one opening onto the verses it comes from, with a Bible reader that works offline.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "minSdkVersion": 24
    }
  }
}
